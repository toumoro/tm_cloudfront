{
  "name": "toumoro/tm-cloudfront",
  "description": "Clears the Amazon CloudFront cache based on the speaking path of a page, on files and on records (cache tags).",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "authors": [
    {
      "name": "Simon Ouellet",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^14.3",
    "typo3/cms-backend": "^14.3",
    "typo3/cms-frontend": "^14.3",
    "typo3/cms-scheduler": "^14.3",
    "aws/aws-sdk-php": "^3.263"
  },
  "autoload": {
    "psr-4": {
      "Toumoro\\TmCloudfront\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Toumoro\\TmCloudfront\\Tests\\": "Tests"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "tm_cloudfront",
      "version": "14.0.0",
      "Package": {
        "providesPackages": {}
      },
      "app-dir": ".Build",
      "web-dir": ".Build/Web"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.1",
    "typo3/testing-framework": "^9.2"
  },
  "config": {
    "bin-dir": ".Build/bin",
    "vendor-dir": ".Build/vendor",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  }
}
